"""連番ログの欠番を、開始番号・終了番号・件数の順に出力する。"""

import re
import sys


def main():
    previous = None
    gaps = []
    for number, line in enumerate(sys.stdin.buffer, 1):
        value = line.strip()
        if not value:
            continue
        if not re.fullmatch(rb"[0-9]{1,18}", value):
            print(f"{number}行目: 1〜18桁の半角数字で入力してください", file=sys.stderr)
            return 1
        current = int(value)
        if previous is not None:
            if current <= previous:
                print(f"{number}行目: 番号が増加していません", file=sys.stderr)
                return 1
            if current > previous + 1:
                gaps.append((previous + 1, current - 1, current - previous - 1))
        previous = current

    if previous is None:
        print("番号がありません", file=sys.stderr)
        return 1
    for gap in gaps:
        print(*gap, sep="\t")
    return 0


if __name__ == "__main__":
    sys.exit(main())
